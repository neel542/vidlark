{
  "name": "Vidlark",
  "short_name": "Vidlark",
  "description": "A free, open source recorder for Mac and Windows: your camera, mic and screen in one take.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#1fd17c",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/mark.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
